{
  "name": "atelier-uto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3060",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "optimize:static-images": "tsx scripts/optimize-static-images.ts",
    "env:local": "tsx scripts/env-local-inject.ts",
    "env:check": "tsx scripts/check-env-drift.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "4.0.0-beta.5",
    "@payloadcms/next": "4.0.0-beta.5",
    "@payloadcms/richtext-lexical": "4.0.0-beta.5",
    "@payloadcms/transformer-sharp": "4.0.0-beta.5",
    "@payloadcms/ui": "4.0.0-beta.5",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "motion": "^12.40.0",
    "next": "16.4.2",
    "payload": "4.0.0-beta.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.8.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
