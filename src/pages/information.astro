---
import Logo from "@/components/home/Logo.astro";
import SiteHeader from "@/components/home/SiteHeader.astro";
import Facts from "@/components/home/studio/Facts.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { informationSections } from "@/lib/information";

const description =
  "Information — Studio Uto im Atelier Uto, Flüelastrasse 16, 8048 Zürich: Daten, Ausstattung, Öffnungszeiten, Preise, Anfahrt, Buchung und Kontakt.";
---

<BaseLayout title="Information" description={description}>
  <main id="content" class="information">
    {/* Full wordmark — identical treatment to the homepage. */}
    <Logo />

    <SiteHeader />

    {/* Numbered sections, the facts in the fact-sheet chip language. */}
    <Facts sections={informationSections} />

    <SiteFooter />
  </main>
</BaseLayout>

<style>
  .information {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding: clamp(6px, 1vh, 12px) var(--page-pad) var(--page-pad);
  }
</style>
