---
import Logo from "@/components/home/Logo.astro";
import SectionNav from "@/components/home/SectionNav.astro";
import SiteHeader from "@/components/home/SiteHeader.astro";
import StudioInfo from "@/components/home/StudioInfo.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { informationSections } from "@/lib/information";

const description =
  "Information — Studio Uto im Atelier Uto, Flüelastrasse 16, 8048 Zürich: Studio, Anfahrt, Buchung und Kontakt.";

const sectionItems = informationSections.map((section) => ({
  label: section.navLabel ?? section.title,
  href: `#${section.id}`,
}));
---

<BaseLayout title="Information" description={description}>
  <main id="content" class="information">
    {/* Full wordmark — identical treatment to the homepage. */}
    <Logo />

    <SiteHeader />

    <SectionNav items={sectionItems} />
    <StudioInfo sections={informationSections} />

    <SiteFooter />
  </main>
</BaseLayout>

<style>
  .information {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding: clamp(6px, 1vh, 12px) var(--page-pad) var(--page-pad);
  }
</style>
