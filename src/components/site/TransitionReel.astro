---
/*
 * Studio reel shown inside the page transition's rising panel (see
 * PageTransition.astro for the renderer, global.css for the choreography).
 * Hidden except while a transition runs; its own view-transition-name keeps it
 * live between the page snapshots and the wordmark/menu.
 */
---

<div class="vt-reel" data-vt-reel aria-hidden="true">
  <canvas></canvas>
  <span class="vt-reel__dest chip" data-vt-reel-dest></span>
</div>

<style>
  .vt-reel {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: none;
    background: var(--color-ink);
    view-transition-name: vt-reel;
  }

  :global(html.vt-reel-on) .vt-reel {
    display: block;
  }

  /* Clean grade: muted greyscale, pulled down so the inverted (white) wordmark
     and menu hold on top of it. */
  .vt-reel canvas {
    display: block;
    width: 100%;
    height: 100%;
    filter: grayscale(1) contrast(1.08) brightness(0.62);
  }

  .vt-reel__dest {
    position: absolute;
    left: var(--page-pad);
    bottom: var(--page-pad);
  }
</style>
