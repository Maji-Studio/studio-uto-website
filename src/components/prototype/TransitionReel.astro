---
/*
 * PROTOTYPE — throwaway. The studio reel shown inside variant D's rising panel
 * (see PageTransitionHead.astro for the renderer and timing). Hidden except
 * while a D transition runs; it has its own view-transition-name so the
 * browser keeps it live on top of the page snapshots.
 */
---

<div class="vt-reel" data-vt-reel aria-hidden="true">
  <canvas></canvas>
  <span class="vt-reel__dest chip" data-vt-reel-dest></span>
</div>

<style>
  .vt-reel {
    position: fixed;
    inset: 0;
    /* Below the logo in paint order, so the wordmark's group stays on top. */
    z-index: -1;
    display: none;
    background: var(--color-ink);
    view-transition-name: vt-reel;
  }

  :global(html.vt-reel-on) .vt-reel {
    display: block;
  }

  /* Clean grade: muted greyscale, pulled down so the white wordmark and chip
     hold on top of it. */
  .vt-reel canvas {
    display: block;
    width: 100%;
    height: 100%;
    filter: grayscale(1) contrast(1.08) brightness(0.62);
  }

  .vt-reel__dest {
    position: absolute;
    left: var(--page-pad);
    bottom: var(--page-pad);
  }
</style>
