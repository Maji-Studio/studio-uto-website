---
// The fact sheet on /information/ (sections from src/lib/information.ts).
//
// Each section opens with its number and title at display size, hung on the
// same two columns as the facts: the grey number in the label column, the
// title in the text column, both cap-aligned. Below, the facts:
// manifesto-size Helvetica lines with every number in a chip, the block labels
// in black chips.
import { Image } from "astro:assets";

import { type StudioSection, studioSections } from "@/lib/studio";

interface Props {
  sections?: readonly StudioSection[];
}

const { sections: source = studioSections } = Astro.props;

// Split a line into text and chips: every number (with its unit), time span,
// day span and price becomes a chip. A unit in brackets loses the brackets.
const NUM = new RegExp(
  [
    String.raw`(?:Mo|Di|Mi|Do|Fr|Sa|So)\s*–\s*(?:Mo|Di|Mi|Do|Fr|Sa|So)`,
    String.raw`\d{1,2}:\d{2}\s*–\s*\d{1,2}:\d{2}(?:\s*Uhr)?`,
    String.raw`CHF\s*\d+(?:[.,]\d+)?`,
    String.raw`\d+(?:\.\d+)?\s?m?\s?×\s?\d+(?:\.\d+)?\s?m\b`,
    String.raw`\(\d+\s?h\)`,
    String.raw`\d+\s?Gb\/s`,
    String.raw`\d+\.\s?Stock`,
    // A measurement keeps its unit inside the chip ("5.7 m", not "5.7" + "m").
    String.raw`\b\d+(?:\.\d+)?\s?(?:m²|m|h)\b`,
    // A bare number counts something only when a word follows it; four digits
    // or more is a postcode or a year, not a count.
    String.raw`\b\d{1,3}(?:\.\d+)?(?=\s+\p{L})`,
  ].join("|"),
  "gu",
);
type Tok = { t: string; chip: boolean };
function tokens(line: string): Tok[] {
  const out: Tok[] = [];
  let at = 0;
  for (const m of line.matchAll(NUM)) {
    const i = m.index ?? 0;
    if (i > at) out.push({ t: line.slice(at, i), chip: false });
    out.push({ t: m[0].replace(/^\((.*)\)$/, "$1"), chip: true });
    at = i + m[0].length;
  }
  if (at < line.length) out.push({ t: line.slice(at), chip: false });
  return out;
}

// A term/detail pair reads as one line: the term, then each detail part as a
// chip ("L 14 m · B 7 m · H 2.7 m" → three chips).
const pairLine = (term: string, detail: string): Tok[] => [
  ...tokens(term),
  { t: " ", chip: false },
  ...detail
    .split(" · ")
    .flatMap((d, i) => [
      ...(i ? [{ t: " ", chip: false }] : []),
      { t: d.trim(), chip: true },
    ]),
];

const nav = source.map((s) => ({
  label: s.navLabel ?? s.title,
  href: `#${s.id}`,
}));

const sections = source.map((s, i) => ({
  id: s.id,
  title: s.title,
  number: String(i + 1).padStart(2, "0"),
  blocks: s.blocks
    .map((b) => ({
      label: b.label,
      lines: [
        ...(b.pairs ?? []).map(([t, d]) => pairLine(t, d)),
        ...(b.lines ?? []).map(tokens),
        ...(b.text ?? []).map(tokens),
      ],
      links: b.links ?? [],
      figure: b.figure,
      note: b.note,
    }))
    // No photo gallery on this page; the homepage hero carries the tour.
    .filter((b) => b.lines.length || b.figure || b.links.length || b.note),
}));
---

<section class="facts" data-facts>
  <nav class="facts-nav" aria-label="Abschnitte">
    {
      nav.map((item) => (
        <a class="chip" href={item.href} data-label={item.label}>
          {item.label}
        </a>
      ))
    }
  </nav>

  {
    sections.map((sec) => (
      <section
        class="facts-sec"
        id={sec.id}
        aria-labelledby={`facts-${sec.id}`}
      >
        <header class="facts-head">
          <span class="facts-head__number" aria-hidden="true">
            {sec.number}
          </span>
          <h2 class="facts-head__title" id={`facts-${sec.id}`}>
            {sec.title}
          </h2>
        </header>

        <div class="facts-body">
          {sec.blocks.map((b) => (
            <div class="facts-block">
              {b.label && <span class="chip facts-label">{b.label}</span>}
              <div class="facts-block__main">
                {b.lines.length > 0 && (
                  <ul class="facts-lines">
                    {b.lines.map((line) => (
                      <li>
                        {line.map((tok) =>
                          tok.chip ? (
                            <span class="facts-num">{tok.t}</span>
                          ) : (
                            tok.t
                          ),
                        )}
                      </li>
                    ))}
                  </ul>
                )}
                {b.figure && (
                  <Image
                    src={b.figure.src}
                    alt={b.figure.alt}
                    widths={[480, 800]}
                    sizes="(max-width: 700px) 100vw, 560px"
                    class="facts-plan"
                  />
                )}
                {b.links.length > 0 && (
                  <div class="facts-links">
                    {b.links.map((l) => (
                      <a
                        class="chip"
                        href={l.href}
                        data-label={l.detail}
                        target={l.external ? "_blank" : undefined}
                        rel={l.external ? "noopener noreferrer" : undefined}
                      >
                        {l.detail}
                      </a>
                    ))}
                  </div>
                )}
                {b.note && <p class="facts-note">{b.note}</p>}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-facts]");

  if (root) {
    // Section nav: the chip of the section under the nav turns grey.
    const links = Array.from(
      root.querySelectorAll<HTMLAnchorElement>(".facts-nav a.chip"),
    );
    const setActive = (id: string) =>
      links.forEach((l) => {
        const on = l.getAttribute("href") === `#${id}`;
        l.classList.toggle("chip--active", on);
        if (on) l.setAttribute("aria-current", "true");
        else l.removeAttribute("aria-current");
      });
    const spy = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
      { rootMargin: "-18% 0px -78% 0px" },
    );
    root
      .querySelectorAll<HTMLElement>(".facts-sec")
      .forEach((s) => spy.observe(s));
  }
</script>

<style>
  .facts {
    --gap: 4px;
    --manifesto: clamp(1.5rem, 3.4vw, 2.4rem);
    --display: clamp(2.6rem, 7vw, 6rem);
    margin-top: clamp(36px, 8vh, 88px);
    padding-bottom: 0;
  }

  .facts-nav {
    position: sticky;
    top: clamp(8px, 1.4vh, 12px);
    z-index: 30;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }

  /* With no rule between sections, the space above each number does the
     separating. */
  .facts-sec {
    padding-top: clamp(88px, 16vh, 184px);
    scroll-margin-top: 40px;
  }

  /* ── The section head ──────────────────────────────────────────────── */

  /* Same columns as .facts-block, so the title starts where the fact lines
     do and the number hangs in the label column. */
  .facts-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    column-gap: 24px;
    align-items: start;
  }

  .facts-head__number,
  .facts-head__title {
    margin: 0;
    font-size: var(--display);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    /* Trim to the caps so number and title share a top edge. */
    text-box: trim-both cap alphabetic;
  }

  .facts-head__number {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ── The facts ───────────────────────────────────────────────────────── */

  .facts-body {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4.5vh, 48px);
    padding-top: clamp(32px, 6vh, 64px);
  }

  .facts-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 10px 24px;
    align-items: start;
  }

  .facts-block__main {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
  }

  .facts-label {
    justify-self: start;
    max-width: 100%;
    margin-top: 0.3em;
    white-space: normal;
  }

  .facts-lines {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--manifesto);
    line-height: 1.16;
    letter-spacing: -0.01em;
  }

  .facts-lines li + li {
    margin-top: 0.12em;
  }

  /* A chip at the line's size: black field, white label, left-aligned with
     trailing space. */
  .facts-num {
    display: inline-block;
    min-width: 2.4em;
    margin: 0.04em 0;
    padding: 0.05em 0.5em 0.07em 0.2em;
    background: var(--color-chip);
    color: var(--color-chip-label);
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .facts-plan {
    width: min(100%, 560px);
    height: auto;
  }

  .facts-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }

  .facts-note {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  @media (max-width: 700px) {
    .facts-block {
      grid-template-columns: minmax(0, 1fr);
    }

    .facts-block__main {
      grid-column: 1;
    }

    /* Number and title share one line. */
    .facts-head {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.4em;
      font-size: var(--display);
    }
  }
</style>
