---
// Studio fact sheet, part 3 of 4: the prices. A black label chip, then every tariff as a huge tight Helvetica line with a
// small grayscale square photo to its left and a muted detail underneath.
import { Image } from "astro:assets";
import { contact } from "@/lib/site";
import { studioSections } from "@/lib/studio";

import nb03 from "@/assets/impressionen/nicolas-burri/nb-03.jpg";
import nb05 from "@/assets/impressionen/nicolas-burri/nb-05.jpg";
import yvy02 from "@/assets/impressionen/matthias-kappeler-yvy/yvy-02.jpg";
import yvy06 from "@/assets/impressionen/matthias-kappeler-yvy/yvy-06.jpg";

const section = studioSections.find((s) => s.id === "preise");
const priceBlock = section?.blocks.find((b) => b.pairs);
const rows = (priceBlock?.pairs ?? []).map(([term, amount]) => {
  const bracket = term.match(/\((.*?)\)/)?.[1];
  return {
    name: term.replace(/\s*\(.*\)/, ""),
    amount: amount.replace(/^CHF\s*/, ""),
    detail: [bracket, amount].filter(Boolean).join(" — "),
  };
});
// Portfolio photographs: nb-03 nb-05 (Manor), yvy-02 yvy-06 (b/w).
const photos = [
  [nb03, "Model in pinkem Sporttop"],
  [yvy02, "Schwarzweiss-Porträt"],
  [nb05, "Porträt mit grüner Kappe"],
  [yvy06, "Schwarzweiss-Aufnahme, zwei Models"],
] as const;
const mail = `mailto:${contact.email}`;
---

<section class="tarife" id="preise" aria-labelledby="tarife-h">
  <h2 class="tarife-lab" id="tarife-h"><b aria-hidden="true">◼</b> Tarife</h2>

  <ul class="tarife-list">
    {
      rows.map((r, i) => (
        <li>
          <Image
            src={photos[i % photos.length][0]}
            alt=""
            widths={[160, 320]}
            sizes="120px"
          />
          <div>
            <span class="tarife-big">{r.name} {r.amount}</span>
            <span class="tarife-sm">{r.detail}</span>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="tarife-foot">
    {priceBlock?.note && <p class="tarife-note">{priceBlock.note}</p>}
    <a class="chip" href={mail} data-label="Jetzt anfragen">Jetzt anfragen</a>
  </div>
</section>

<style>
  .tarife {
    /* Follows the chrome intro directly; the intro stage carries the gap. */
    margin-top: 0;
    color: var(--color-ink);
    scroll-margin-top: 48px;
  }

  .tarife-lab {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    padding: 0.42rem 0.6rem 0.42rem 0.5rem;
    background: var(--color-chip, #111);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1;
  }

  .tarife-lab b {
    font-size: 0.6rem;
    font-weight: 400;
  }

  .tarife-list {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
  }

  .tarife-list li {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.6rem);
    margin: 0;
    padding: 0.15rem 0;
  }

  .tarife-list li :global(img) {
    flex: none;
    width: clamp(2.6rem, 6vw, 5.2rem);
    height: clamp(2.6rem, 6vw, 5.2rem);
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1);
  }

  .tarife-list li div {
    min-width: 0;
  }

  .tarife-big {
    display: block;
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 6.2vw, 5.6rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .tarife-sm {
    display: block;
    margin-top: 0.3rem;
    color: var(--color-muted);
    font-size: 0.7rem;
    line-height: 1.2;
  }

  .tarife-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: clamp(28px, 5vh, 56px);
  }

  .tarife-note {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.3;
  }
</style>
