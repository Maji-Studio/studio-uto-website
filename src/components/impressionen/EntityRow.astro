---
import { getImage, Image } from "astro:assets";

import type { Impression } from "@/lib/impressionen";

interface Props {
  entity: Impression;
}

const { entity } = Astro.props;

// Used when an image carries no explicit alt text.
const fallbackAlt = `Arbeit von ${entity.name}${
  entity.client ? ` für ${entity.client}` : ""
}.`;

// Large renditions for the full-screen viewer (Lightbox.astro), handed over
// through data attributes on each thumbnail button.
const full = await Promise.all(
  entity.images.map((image) =>
    getImage({ src: image.src, widths: [1280, 1920, 2560], format: "webp" }),
  ),
);
---

<article
  class="entity"
  data-lightbox-gallery
  data-name={entity.name}
  data-client={entity.client}
>
  <header class="entity__meta">
    {
      /* The rule stays on the page; only the title lifts into the lightbox
        header, so the rule is kept out of the morphing element. */
    }
    <span class="entity__rule" aria-hidden="true"></span>
    <div class="entity__title" data-lightbox-title>
      <h2 class="entity__name">{entity.name}</h2>
      {entity.client && <p class="entity__client">for {entity.client}</p>}
    </div>
  </header>

  <ul class="entity__grid" role="list">
    {
      entity.images.map((image, i) => (
        <li class="entity__cell">
          <button
            class="entity__open"
            type="button"
            data-lightbox-open
            data-src={full[i].src}
            data-srcset={full[i].srcSet.attribute}
            data-width={image.src.width}
            data-height={image.src.height}
            data-alt={image.alt ?? fallbackAlt}
            aria-label={`Bild ${i + 1} von ${entity.images.length} öffnen`}
          >
            <Image
              class="entity__image"
              src={image.src}
              alt={image.alt ?? fallbackAlt}
              style={image.objectPosition ? { objectPosition: image.objectPosition } : undefined}
              widths={[240, 360, 480]}
              sizes="(max-width: 720px) 30vw, 18vw"
              loading="lazy"
            />
          </button>
        </li>
      ))
    }
  </ul>
</article>

<style>
  /*
   * Two equal halves with an 8px gutter: collaborator meta (with its top
   * hairline) on the left, image grid on the right. The hairline runs the full
   * left column, level with the images' top edge, and the 8px column gap
   * separates it from the gallery. The images sit flush, with no gap between.
   */
  .entity {
    --impression-gap: 8px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--impression-gap);
    align-items: start;
  }

  .entity__rule {
    display: block;
    height: 1px;
    margin-bottom: 10px;
    background: var(--color-ink);
  }

  /* Sized to its text, exactly like the lightbox title it morphs into, so the
     snapshot moves without being stretched. */
  .entity__title {
    width: max-content;
    max-width: 100%;
  }

  .entity__name,
  .entity__client {
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: 0.005em;
  }

  .entity__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entity__cell {
    margin: 0;
    /* Let the cell shrink below the image's intrinsic width so the 1fr tracks
       stay equal and the column gap is never eaten by grid blowout. */
    min-width: 0;
  }

  .entity__open {
    display: block;
    width: 100%;
    border: 0;
    padding: 0;
    background: none;
    cursor: zoom-in;
  }

  .entity__open:focus-visible {
    outline-offset: -2px;
  }

  .entity__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .entity {
      grid-template-columns: 1fr;
      row-gap: 12px;
    }
  }
</style>
